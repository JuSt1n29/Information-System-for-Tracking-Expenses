<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.AccountsWindow"
        Title="Керування рахунками" Width="800" Height="500"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*, Auto, Auto" Margin="15" RowSpacing="10">
        <!-- Таблиця -->
        <DataGrid Grid.Row="0" x:Name="AccountsGrid"
                  AutoGenerateColumns="True"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  GridLinesVisibility="All"
                  BorderBrush="LightGray" BorderThickness="1"/>

        <!-- Поля вводу -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <StackPanel Spacing="2">
                <TextBlock Text="Name" FontSize="10" Foreground="Gray"/>
                <TextBox x:Name="NameBox" Width="150" Height="28"/>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Type" FontSize="10" Foreground="Gray"/>
                <TextBox x:Name="TypeBox" Width="100" Height="28"/>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Currency" FontSize="10" Foreground="Gray"/>
                <TextBox x:Name="CurrencyBox" Width="80" Height="28"/>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="Balance" FontSize="10" Foreground="Gray"/>
                <TextBox x:Name="BalanceBox" Width="100" Height="28"/>
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="ID (Edit/Del)" FontSize="10" Foreground="Gray"/>
                <TextBox x:Name="UpdateIdBox" Width="80" Height="28" IsReadOnly="True"/>
            </StackPanel>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button Content="Add" Click="OnAddClick" Background="#D4EDDA" Width="100"/>
            <Button Content="Update" Click="OnUpdateClick" Background="#FFF3CD" Width="100"/>
            <Button Content="Delete" Click="OnDeleteClick" Background="#F8D7DA" Foreground="Red" Width="100"/>
            <Button Content="Close" Click="OnCloseClick" Width="90"/>
        </StackPanel>
    </Grid>
</Window>