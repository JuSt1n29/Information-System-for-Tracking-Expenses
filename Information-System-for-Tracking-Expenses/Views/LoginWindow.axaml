<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.LoginWindow"
        Title="FinancialApp — Sign In" Width="400" Height="460"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen" CanResize="False">

    <Border Margin="20" Padding="26" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12">
        <StackPanel Spacing="14" VerticalAlignment="Center">

            <StackPanel Spacing="6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" VerticalAlignment="Center"/>
                    <TextBlock Text="FinancialApp" FontSize="21" FontWeight="Bold" Foreground="#F8FAFC"/>
                </StackPanel>
                <TextBlock Text="Інформаційна система обліку витрат" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Email or Username" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                <TextBox x:Name="EmailBox" Height="36" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="10,7" PlaceholderText="admin@terminal.local"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                <TextBox x:Name="PasswordBox" PasswordChar="•" Height="36" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="10,7" PlaceholderText="••••••••"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Text="" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" IsVisible="False"/>

            <Button Content="Sign In" Click="OnLoginClick" Height="38" Background="#10B981" Foreground="#06281E" FontWeight="Bold" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="0,4,0,0">
                <TextBlock Text="No account?" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <Button Content="Register" Click="OnOpenRegisterClick" Background="Transparent" Foreground="#10B981" Padding="4,2" FontSize="12" FontWeight="Bold"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>