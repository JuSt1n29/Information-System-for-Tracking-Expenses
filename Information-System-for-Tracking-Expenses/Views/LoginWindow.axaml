<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.LoginWindow"
        Title="Dark Terminal — Sign In" Width="380" Height="440"
        Background="#121614" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen" CanResize="False">

    <Border Margin="20" Padding="25" Background="#1A1F1C" BorderBrush="#3A4D40" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="14" VerticalAlignment="Center">
            
            <!-- Заголовок -->
            <StackPanel Spacing="4" Margin="0,0,0,10">
                <TextBlock Text="DARK TERMINAL" FontSize="20" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center"/>
                <TextBlock Text="Financial Tracking System" FontSize="12" Foreground="#88A093" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Поле Email / Логин -->
            <StackPanel Spacing="4">
                <TextBlock Text="Email or Username" FontSize="11" Foreground="#A39382"/>
                <TextBox x:Name="EmailBox" Height="34" Background="#161210" Foreground="White" BorderBrush="#5C4033" Watermark="admin@terminal.local"/>
            </StackPanel>

            <!-- Поле Пароль -->
            <StackPanel Spacing="4">
                <TextBlock Text="Password" FontSize="11" Foreground="#A39382"/>
                <TextBox x:Name="PasswordBox" PasswordChar="•" Height="34" Background="#161210" Foreground="White" BorderBrush="#5C4033" Watermark="••••••••"/>
            </StackPanel>

            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="ErrorText" Text="" FontSize="11" Foreground="#FF7B7B" HorizontalAlignment="Center" IsVisible="False"/>

            <!-- Кнопка Входа -->
            <Button Content="Sign In" Click="OnLoginClick" Height="36" Background="#2D5A27" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>

            <!-- Переход к регистрации -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="0,5,0,0">
                <TextBlock Text="No account?" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                <Button Content="Register" Click="OnOpenRegisterClick" Background="Transparent" Foreground="#D4A373" Padding="4,2" FontSize="12" FontWeight="Bold"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>