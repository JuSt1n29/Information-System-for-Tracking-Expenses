<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.LoginWindow"
        Title="Авторизація"
        Width="350" Height="280"
        WindowStartupLocation="CenterScreen">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="260" Spacing="10">
        <TextBlock Text="Вхід у систему" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBox x:Name="EmailInput" Watermark="Email"/>
        <TextBox x:Name="PasswordInput" Watermark="Пароль" PasswordChar="*"/>

        <TextBlock x:Name="ErrorText" Foreground="Red" HorizontalAlignment="Center" IsVisible="False"/>

        <Button Content="Увійти" Click="OnLoginClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        
        <Button Content="Зареєструватися" Click="OnOpenRegisterClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent"/>
    </StackPanel>
</Window>