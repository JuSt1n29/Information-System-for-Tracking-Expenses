<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.ProfileWindow"
        Title="My Profile" Width="450" Height="575"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterOwner" CanResize="False">

    <Border Margin="16" Padding="22" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Text="My Profile" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RoleSubtitleText" Text="" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,4">
                    <Border Width="92" Height="92" CornerRadius="46" ClipToBounds="True"
                            Background="#0F172A" BorderBrush="#10B981" BorderThickness="2">
                        <Image x:Name="AvatarPreviewImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Click="OnSelectAvatarClick" Height="30" Padding="12,0" CornerRadius="6"
                                Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="linealIcon" Data="{StaticResource IconUpload}" Stroke="#10B981" Width="14" Height="14"/>
                                <TextBlock Text="Upload Photo" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnRemoveAvatarClick" Height="30" Padding="12,0" CornerRadius="6"
                                Background="#0F172A" Foreground="#F87171" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="linealIcon" Data="{StaticResource IconTrash}" Stroke="#F87171" Width="14" Height="14"/>
                                <TextBlock Text="Remove" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Name *" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBox x:Name="NameBox" Height="34" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="10,6"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Email *" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBox x:Name="EmailBox" Height="34" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="10,6"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Current Password (required to change password)" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBox x:Name="CurrentPasswordBox" PasswordChar="•" Height="34" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="10,6"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="New Password (leave empty to keep current)" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBox x:Name="NewPasswordBox" PasswordChar="•" Height="34" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="10,6"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#F87171" TextWrapping="Wrap" IsVisible="False"/>

                <Grid ColumnDefinitions="*, 10, *" Margin="0,8,0,0">
                    <Button Grid.Column="0" Content="Cancel" Click="OnCancelClick" Height="36" CornerRadius="8"
                            Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Save" Click="OnSaveClick" Height="36" CornerRadius="8"
                            Background="#10B981" Foreground="#06281E" FontWeight="Bold"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>