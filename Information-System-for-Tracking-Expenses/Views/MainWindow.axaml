<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.MainWindow"
        Title="FinancialApp - Transactions"
        Width="950" Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="15" RowSpacing="10">
        
        <!-- Меню / Навигация по справочникам -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Background="#F8F9FA" Margin="0,0,0,5">
            <Button Content="Accounts" Click="OnOpenAccountsClick" Width="100"/>
            <Button Content="Counterparties" Click="OnOpenCounterpartiesClick" Width="120"/>
            <Button Content="Employees" Click="OnOpenEmployeesClick" Width="110"/>
            <Button Content="Categories" Click="OnOpenCategoriesClick" Width="100"/>
        </StackPanel>

        <!-- Таблица транзакций -->
        <DataGrid Grid.Row="1" x:Name="TransactionsGrid"
                  AutoGenerateColumns="True"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  GridLinesVisibility="All"
                  BorderBrush="LightGray" BorderThickness="1"/>

        <!-- Панель действий с выбранной строкой (скрыта, пока строка не выбрана) -->
        <StackPanel Grid.Row="2" x:Name="ActionPanel" IsVisible="False" Spacing="8" Background="#FFF8E1" Margin="0,5">
            <TextBlock Text="Selected Transaction Management:" FontWeight="Bold" FontSize="12" Margin="5,5,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,0,5,5">
                <StackPanel Spacing="2">
                    <TextBlock Text="Amount" FontSize="10" Foreground="Gray"/>
                    <TextBox x:Name="EditAmountBox" Width="90" Height="26"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Description" FontSize="10" Foreground="Gray"/>
                    <TextBox x:Name="EditDescriptionBox" Width="200" Height="26"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="ID" FontSize="10" Foreground="Gray"/>
                    <TextBox x:Name="UpdateIdBox" Width="60" Height="26" IsReadOnly="True"/>
                </StackPanel>
                <Button Content="Update" Click="OnUpdateClick" Background="#FFF3CD" Width="100" VerticalAlignment="Bottom"/>
                <Button Content="Delete" Click="OnDeleteClick" Background="#F8D7DA" Foreground="Red" Width="100" VerticalAlignment="Bottom"/>
            </StackPanel>
        </StackPanel>

        <!-- Основные кнопки управления -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
            <Button Content="Add Transaction" Click="OnAddClick" Background="#D4EDDA" Width="140"/>
            <Button Content="Refresh List" Click="OnRefreshClick" Width="110"/>
        </StackPanel>
    </Grid>
</Window>