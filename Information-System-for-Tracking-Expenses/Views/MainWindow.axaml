<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.MainWindow"
        Title="FinancialApp - Transactions"
        Width="1050" Height="620"
        Background="#121614"
        Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="15" RowSpacing="10">
        
        <!-- Меню / Навигация по справочникам и значок профиля в углу -->
        <Border Grid.Row="0" Background="#1B2E23" Margin="0,0,0,5" Padding="8" CornerRadius="6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
                    <Button Content="Accounts" Click="OnOpenAccountsClick" Width="100" Background="#2D4F3C" Foreground="White"/>
                    <Button Content="Counterparties" Click="OnOpenCounterpartiesClick" Width="120" Background="#2D4F3C" Foreground="White"/>
                    <Button x:Name="EmployeesButton" Content="Employees" Click="OnOpenEmployeesClick" Width="110" Background="#2D4F3C" Foreground="White"/>
                    <Button Content="Categories" Click="OnOpenCategoriesClick" Width="100" Background="#2D4F3C" Foreground="White"/>
                    <Button x:Name="UsersButton" Content="Users" Click="OnOpenUsersClick" Width="100" Background="#4A3520" Foreground="#F5D0A9" IsVisible="False"/>
                </StackPanel>

                <!-- Кликабельный значок профиля в правом углу -->
                <Button DockPanel.Dock="Right" Click="OnOpenProfileClick" Padding="6,2" Height="34"
                        Background="#221C18" BorderBrush="#5C4033" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True"
                                Background="#2B3630" BorderBrush="#D4A373" BorderThickness="1">
                            <Image x:Name="HeaderAvatarImage" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="CurrentUserText" VerticalAlignment="Center" FontSize="12" Foreground="#E0E0E0"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Таблица транзакций -->
        <DataGrid Grid.Row="1" x:Name="TransactionsGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  AutoGeneratingColumn="OnAutoGeneratingColumn"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  GridLinesVisibility="All"
                  Background="#1A1F1C"
                  RowBackground="#1A1F1C"
                  Foreground="#E0E0E0"
                  BorderBrush="#3A4D40" BorderThickness="1"/>

        <!-- Панель действий с выбранной строкой -->
        <Border Grid.Row="2" x:Name="ActionPanel" IsVisible="False" Background="#221C18" Margin="0,5" Padding="10" CornerRadius="6">
            <StackPanel Spacing="8">
                <TextBlock Text="Selected Transaction Management:" FontWeight="Bold" FontSize="12" Foreground="#D4A373" Margin="2,0,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Document" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="DocumentBox" Width="110" Height="28" Background="#161210" Foreground="#A39382" BorderBrush="#5C4033" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Amount" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EditAmountBox" Width="110" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Description" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EditDescriptionBox" Width="260" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>
                    <Button Content="Update" Click="OnUpdateClick" Background="#8B5A2B" Foreground="White" Width="100" VerticalAlignment="Bottom" Height="28"/>
                    <Button Content="Delete" Click="OnDeleteClick" Background="#4E2A1D" Foreground="#FFA0A0" Width="100" VerticalAlignment="Bottom" Height="28"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#FF8A8A" IsVisible="False"/>
            </StackPanel>
        </Border>

        <!-- Основные кнопки управления -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
            <Button Content="Add Transaction" Click="OnAddClick" Background="#2D5A27" Foreground="White" Width="140" Height="32"/>
            <Button Content="Refresh List" Click="OnRefreshClick" Background="#2B3630" Foreground="#CCC" Width="110" Height="32"/>
        </StackPanel>
    </Grid>
</Window>