<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.UsersWindow"
        Title="Users Management" Width="960" Height="560"
        Background="#121614" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*, Auto, Auto" Margin="15" RowSpacing="10">

        <DataGrid Grid.Row="0" x:Name="UsersGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  AutoGeneratingColumn="OnAutoGeneratingColumn"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  GridLinesVisibility="All"
                  Background="#1A1F1C" RowBackground="#1A1F1C" Foreground="#E0E0E0"
                  BorderBrush="#3A4D40" BorderThickness="1"/>

        <!-- Встроенная панель добавления и редактирования пользователя -->
        <Border Grid.Row="1" x:Name="ActionPanel" IsVisible="True" Background="#221C18" Margin="0,5" Padding="10" CornerRadius="6">
            <StackPanel Spacing="8">
                <TextBlock x:Name="PanelTitleText" Text="Add New User:" FontWeight="Bold" FontSize="12" Foreground="#D4A373" Margin="2,0,0,0"/>

                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Name *" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="NameBox" Width="130" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Email *" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EmailBox" Width="165" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock x:Name="PasswordLabel" Text="Password *" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="PasswordBox" PasswordChar="•" Width="130" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Role" FontSize="10" Foreground="#A39382"/>
                        <ComboBox x:Name="RoleComboBox" Width="105" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033">
                            <ComboBoxItem Content="user"/>
                            <ComboBoxItem Content="admin"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="AddButton" Content="Add" Click="OnAddClick" Background="#2D5A27" Foreground="White" Width="75" VerticalAlignment="Bottom" Height="28"/>
                    <Button x:Name="UpdateButton" Content="Update" Click="OnUpdateClick" Background="#8B5A2B" Foreground="White" Width="80" VerticalAlignment="Bottom" Height="28" IsVisible="False"/>
                    <Button x:Name="DeleteButton" Content="Delete" Click="OnDeleteClick" Background="#4E2A1D" Foreground="#FFA0A0" Width="80" VerticalAlignment="Bottom" Height="28" IsVisible="False"/>
                    <Button Content="Clear" Click="OnClearClick" Background="#2A221E" Foreground="#CCC" Width="70" VerticalAlignment="Bottom" Height="28"/>
                </WrapPanel>

                <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#FF8A8A" IsVisible="False"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button Content="Refresh List" Click="OnRefreshClick" Background="#2B3630" Foreground="#CCC" Width="110" Height="32"/>
        </StackPanel>
    </Grid>
</Window>