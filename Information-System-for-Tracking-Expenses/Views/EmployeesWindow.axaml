<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.EmployeesWindow"
        Title="Employees Management" Width="950" Height="500"
        Background="#121614" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*, Auto, Auto" Margin="15" RowSpacing="10">
        
        <DataGrid Grid.Row="0" x:Name="EmployeesGrid"
                  AutoGenerateColumns="True"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  GridLinesVisibility="All"
                  Background="#1A1F1C" RowBackground="#1A1F1C" Foreground="#E0E0E0"
                  BorderBrush="#3A4D40" BorderThickness="1"/>

        <Border Grid.Row="1" x:Name="ActionPanel" IsVisible="False" Background="#221C18" Margin="0,5" Padding="10" CornerRadius="6">
            <StackPanel Spacing="8">
                <TextBlock Text="Selected Employee Management:" FontWeight="Bold" FontSize="12" Foreground="#D4A373" Margin="2,0,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Full Name" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EditNameBox" Width="130" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Position" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EditPositionBox" Width="100" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Phone" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EditPhoneBox" Width="90" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Email" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EditEmailBox" Width="110" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Salary" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EditSalaryBox" Width="80" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Status" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="EditStatusBox" Width="80" Height="28" Background="#161210" Foreground="White" BorderBrush="#5C4033"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="ID" FontSize="10" Foreground="#A39382"/>
                        <TextBox x:Name="UpdateIdBox" Width="40" Height="28" Background="#161210" Foreground="#888" BorderBrush="#5C4033" IsReadOnly="True"/>
                    </StackPanel>
                    <Button Content="Update" Click="OnUpdateClick" Background="#8B5A2B" Foreground="White" Width="80" VerticalAlignment="Bottom" Height="28"/>
                    <Button Content="Delete" Click="OnDeleteClick" Background="#4E2A1D" Foreground="#FFA0A0" Width="80" VerticalAlignment="Bottom" Height="28"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button Content="Refresh List" Click="OnRefreshClick" Background="#2B3630" Foreground="#CCC" Width="110" Height="32"/>
        </StackPanel>
    </Grid>
</Window>