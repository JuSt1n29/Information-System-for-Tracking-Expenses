<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.EmployeesWindow"
        Title="Employees Management" Width="1050" Height="540"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="18" RowSpacing="12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <Path Classes="linealIcon" Data="{StaticResource IconEmployees}" Stroke="#10B981" Width="22" Height="22"/>
            <TextBlock Text="Employees Management" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <DataGrid x:Name="EmployeesGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      AutoGeneratingColumn="OnAutoGeneratingColumn"
                      SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#293548"
                      Background="#1E293B" RowBackground="#1E293B" Foreground="#F8FAFC"
                      BorderThickness="0"/>
        </Border>

        <Border Grid.Row="2" x:Name="ActionPanel" IsVisible="True" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="14" CornerRadius="10">
            <StackPanel Spacing="10">
                <TextBlock x:Name="PanelTitleText" Text="Add New Employee:" FontWeight="Bold" FontSize="12" Foreground="#10B981"/>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Full Name *" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox x:Name="EditNameBox" Width="150" Height="32" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Position" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox x:Name="EditPositionBox" Width="110" Height="32" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Phone" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox x:Name="EditPhoneBox" Width="105" Height="32" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Email" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox x:Name="EditEmailBox" Width="125" Height="32" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Salary" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox x:Name="EditSalaryBox" Width="90" Height="32" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6"/>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Status" FontSize="10" Foreground="#94A3B8"/>
                        <TextBox x:Name="EditStatusBox" Width="85" Height="32" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6"/>
                    </StackPanel>

                    <Button x:Name="AddButton" Click="OnAddClick" Background="#10B981" Foreground="#06281E" FontWeight="Bold" Width="85" Height="32" CornerRadius="6" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Path Classes="linealIcon" Data="{StaticResource IconPlus}" Stroke="#06281E" Width="14" Height="14"/>
                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateButton" Click="OnUpdateClick" Background="#D97706" Foreground="White" FontWeight="SemiBold" Width="95" Height="32" CornerRadius="6" VerticalAlignment="Bottom" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Path Classes="linealIcon" Data="{StaticResource IconEdit}" Stroke="White" Width="14" Height="14"/>
                            <TextBlock Text="Update" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Click="OnDeleteClick" Background="#DC2626" Foreground="White" FontWeight="SemiBold" Width="95" Height="32" CornerRadius="6" VerticalAlignment="Bottom" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Path Classes="linealIcon" Data="{StaticResource IconTrash}" Stroke="White" Width="14" Height="14"/>
                            <TextBlock Text="Delete" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnClearClick" Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" Width="80" Height="32" CornerRadius="6" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Path Classes="linealIcon" Data="{StaticResource IconClear}" Stroke="#CBD5E1" Width="13" Height="13"/>
                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#F87171" IsVisible="False"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
            <Button Click="OnRefreshClick" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Width="135" Height="34" CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Path Classes="linealIcon" Data="{StaticResource IconRefresh}" Stroke="#E2E8F0" Width="15" Height="15"/>
                    <TextBlock Text="Refresh List" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>