<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.AddTransactionWindow"
        Title="New Transaction" Width="400" Height="450"
        WindowStartupLocation="CenterOwner" CanResize="False">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Create New Transaction" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <StackPanel Spacing="3">
            <TextBlock Text="Account ID" FontSize="11" Foreground="Gray"/>
            <TextBox x:Name="AccountIdBox" Height="30"/>
        </StackPanel>

        <StackPanel Spacing="3">
            <TextBlock Text="Type (expense / income)" FontSize="11" Foreground="Gray"/>
            <TextBox x:Name="TypeBox" Height="30" Text="expense"/>
        </StackPanel>

        <StackPanel Spacing="3">
            <TextBlock Text="Amount" FontSize="11" Foreground="Gray"/>
            <TextBox x:Name="AmountBox" Height="30"/>
        </StackPanel>

        <StackPanel Spacing="3">
            <TextBlock Text="Currency" FontSize="11" Foreground="Gray"/>
            <TextBox x:Name="CurrencyBox" Height="30" Text="UAH"/>
        </StackPanel>

        <StackPanel Spacing="3">
            <TextBlock Text="Category ID" FontSize="11" Foreground="Gray"/>
            <TextBox x:Name="CategoryIdBox" Height="30"/>
        </StackPanel>

        <StackPanel Spacing="3">
            <TextBlock Text="Description" FontSize="11" Foreground="Gray"/>
            <TextBox x:Name="DescriptionBox" Height="30"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Width="90" Height="32"/>
            <Button Content="Save" Click="OnSaveClick" Background="#D4EDDA" Width="100" Height="32"/>
        </StackPanel>
    </StackPanel>
</Window>