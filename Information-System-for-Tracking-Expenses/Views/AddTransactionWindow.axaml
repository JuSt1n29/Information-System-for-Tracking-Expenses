<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InformationSystemForTrackingExpenses.Views.AddTransactionWindow"
        Title="New Transaction" Width="450" Height="680"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterOwner" CanResize="False">

    <Border Margin="16" Padding="22" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2" Margin="0,0,0,6">
                    <TextBlock Text="Create New Transaction" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Заповніть реквізити фінансової операції" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Счёт -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Account *" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <ComboBox x:Name="AccountComboBox" Height="36" Background="#0F172A" Foreground="#F8FAFC"
                              BorderBrush="#334155" CornerRadius="6" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Категория -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Category *" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <ComboBox x:Name="CategoryComboBox" Height="36" Background="#0F172A" Foreground="#F8FAFC"
                              BorderBrush="#334155" CornerRadius="6" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Контрагент -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Counterparty" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <ComboBox x:Name="CounterpartyComboBox" Height="36" Background="#0F172A" Foreground="#F8FAFC"
                              BorderBrush="#334155" CornerRadius="6" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Сотрудник -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Employee" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <ComboBox x:Name="EmployeeComboBox" Height="36" Background="#0F172A" Foreground="#F8FAFC"
                              BorderBrush="#334155" CornerRadius="6" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Тип и Валюта в одной строке -->
                <Grid ColumnDefinitions="*, 12, 130">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Type" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <ComboBox x:Name="TypeComboBox" Height="36" Background="#0F172A" Foreground="#F8FAFC"
                                  BorderBrush="#334155" CornerRadius="6" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="expense"/>
                            <ComboBoxItem Content="income"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Currency" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <ComboBox x:Name="CurrencyComboBox" Height="36" Background="#0F172A" Foreground="#F8FAFC"
                                  BorderBrush="#334155" CornerRadius="6" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="UAH"/>
                            <ComboBoxItem Content="USD"/>
                            <ComboBoxItem Content="EUR"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Сумма -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Amount *" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                    <TextBox x:Name="AmountBox" Height="36" Watermark="0.00" Background="#0F172A" Foreground="#F8FAFC"
                             BorderBrush="#10B981" CornerRadius="6" Padding="10,7"/>
                </StackPanel>

                <!-- Описание -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Description" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBox x:Name="DescriptionBox" Height="36" Watermark="Optional note..." Background="#0F172A" Foreground="#F8FAFC"
                             BorderBrush="#334155" CornerRadius="6" Padding="10,7"/>
                </StackPanel>

                <!-- Сообщение об ошибке валидации -->
                <TextBlock x:Name="ErrorText" Text="" FontSize="11" Foreground="#F87171" TextWrapping="Wrap" IsVisible="False"/>

                <!-- Кнопки -->
                <Grid ColumnDefinitions="*, 10, *" Margin="0,10,0,0">
                    <Button Grid.Column="0" Content="Cancel" Click="OnCancelClick" Height="36"
                            Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Save" Click="OnSaveClick" Height="36"
                            Background="#10B981" Foreground="#06281E" FontWeight="Bold"
                            CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>